# ==============================
#  wabot-aq 3.0 — configuration
#  Copy this file to ".env":   cp .env.example .env
# ==============================

# Bot name and owner (country code, no +, comma separated for multiple)
BOT_NAME=Aqua Bot
OWNER=1234567890

# Bot language: en, tr, id, es (users can change their own with .lang)
LOCALE=en

# Command prefix (multiple allowed: . ! #)
PREFIX=.

# Session name (stored under sessions/<SESSION_NAME>)
SESSION_NAME=aqua

# Bot mode: public (everyone) | self (owner only)
MODE=public

# Timezone
TZ=Europe/Istanbul

# Web panel for QR pairing (useful on VPS/Docker)
WEB_SERVER=false
WEB_PORT=3000

# AI — any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama…)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Limits
MAX_FILE_SIZE=104857600
COMMAND_COOLDOWN=3

# Sticker watermark
STICKER_PACKNAME=Aqua Bot
STICKER_AUTHOR=wabot-aq
