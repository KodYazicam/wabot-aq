# ==============================================================================
#  wabot-aq 3.0 — configuration
#
#  This file is a template. Easiest way to fill it in:  npm run setup
#  (an interactive wizard asks everything and writes .env for you).
#
#  Manual way: copy this file to ".env" and edit the values below:
#      cp .env.example .env
#
#  Lines starting with # are comments. Never commit or share your .env —
#  it contains private settings for YOUR bot.
# ==============================================================================

# ── Identity ─────────────────────────────────────────────────────────────────

# The name shown for the bot in WhatsApp. Any short text works.
BOT_NAME=Aqua Bot

# YOUR WhatsApp number = the bot's owner. Format: country code + number,
# digits only (no +, no spaces). Examples: 905321234567 (Turkey),
# 6281234567890 (Indonesia), 15551234567 (US). Separate several with commas.
# The owner can use admin commands, change settings, broadcast, etc.
OWNER=

# ── Behavior ─────────────────────────────────────────────────────────────────

# Bot language for messages: en (English), tr (Turkish), id (Indonesian),
# es (Spanish), de (German), fr (French). Every user can still switch their
# own language with .lang
LOCALE=en

# Command prefix: the character(s) before a command, e.g. ".menu".
# Multiple are allowed, e.g. ".!" accepts both .menu and !menu
PREFIX=.

# Session name — each name is a separate WhatsApp login, stored under
# sessions/<name>. Change it to run multiple bots from one folder.
SESSION_NAME=aqua

# MODE=public → everyone can use the bot (default)
# MODE=self   → only the owner (you) can use it — good for private bots
MODE=public

# Timezone for dates shown by the bot (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Istanbul

# ── Web panel (optional) ─────────────────────────────────────────────────────

# WEB_SERVER=true shows a small web page with the pairing QR code — useful
# on a VPS or Docker where you can't see the terminal. Then open:
#   http://YOUR-SERVER-IP:WEB_PORT
WEB_SERVER=false
WEB_PORT=3000
# Which network interface to bind. 0.0.0.0 = reachable from other machines
# (fine with a firewall), 127.0.0.1 = only reachable locally (use an SSH
# tunnel to reach it remotely)
WEB_HOST=0.0.0.0

# ── Artificial intelligence (optional) ───────────────────────────────────────

# Any OpenAI-compatible chat API works. Examples:
#   OpenAI:     key=sk-...      base=https://api.openai.com/v1     model=gpt-4o-mini
#   Groq:       key=gsk_...     base=https://api.groq.com/openai/v1 model=llama-3.1-8b-instant
#   OpenRouter: key=sk-or-...   base=https://openrouter.ai/api/v1   model=...
#   Ollama:     key=ollama      base=http://127.0.0.1:11434/v1      model=llama3
# Leave AI_API_KEY empty to disable the .ai command.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Safety limits ────────────────────────────────────────────────────────────

# Maximum file size the bot will download/send, in bytes (104857600 = 100 MB)
MAX_FILE_SIZE=104857600

# How long users must wait between using the same command (seconds)
COMMAND_COOLDOWN=3

# SAFE_MODE=true disables .exec (running shell commands on the host).
# Recommended on shared/public infrastructure. Owner-only either way.
SAFE_MODE=false

# ── Stickers ─────────────────────────────────────────────────────────────────

# Watermark shown when you view a sticker's details (pack name / author)
STICKER_PACKNAME=Aqua Bot
STICKER_AUTHOR=wabot-aq
