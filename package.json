{
  "name": "wabot-aq",
  "version": "3.0.0",
  "description": "Modern, multi-language WhatsApp bot — a complete rewrite of Nurutomo/wabot-aq on Baileys 7 (multi-device)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "setup": "node scripts/setup.mjs",
    "selftest": "node src/index.js --selftest",
    "selftest:offline": "node src/index.js --selftest --offline",
    "docs": "node scripts/generate-docs.mjs"
  },
  "keywords": [
    "whatsapp-bot",
    "whatsapp",
    "baileys",
    "bot",
    "sticker",
    "multi-device"
  ],
  "homepage": "https://github.com/KodYazicam/wabot-aq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/wabot-aq.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/wabot-aq/issues"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "node-webpmux": "^3.2.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "yt-search": "^2.13.1"
  }
}
